[Unit]
Description=RichIris suspect watch (email when a group appears on the front cameras late at night)
After=network-online.target richiris-people.service
Wants=network-online.target
RequiresMountsFor=/var/lib/richiris

[Service]
Type=simple
User=richard
Group=richard
WorkingDirectory=/opt/richiris/scripts
ExecStart=/opt/richiris/venv/bin/python /opt/richiris/scripts/suspect_watch.py --daemon
Restart=always
RestartSec=15
Nice=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
