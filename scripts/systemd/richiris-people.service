[Unit]
Description=RichIris people snapshots (a crop of every detected person -> /var/lib/richiris/people + Immich)
After=network-online.target richiris.service
Wants=network-online.target
RequiresMountsFor=/var/lib/richiris /mnt/backup

[Service]
Type=simple
User=richard
Group=richard
WorkingDirectory=/opt/richiris/scripts
ExecStart=/opt/richiris/venv/bin/python /opt/richiris/scripts/people_snapshots.py --daemon
Restart=always
RestartSec=15
Nice=12
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=280%
MemoryHigh=2500M
MemoryMax=3G
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=3

[Install]
WantedBy=multi-user.target
